{
	"name": "@earendil-works/pi-codemarie",
	"publisher": "earendil-works",
	"version": "0.83.0",

	"description": "Codemarie / LUMI agent core controller, task lifecycle, state persistence, and MoD prompt steering",
	"license": "Apache-2.0",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./hosts": {
			"types": "./src/hosts/index.ts",
			"import": "./src/hosts/index.ts"
		},
		"./joyride": {
			"types": "./src/core/joyride/index.ts",
			"import": "./src/core/joyride/index.ts"
		},
		"./storage": {
			"types": "./src/services/storage/StorageManager.ts",
			"import": "./src/services/storage/StorageManager.ts"
		},
		"./transform": {
			"types": "./src/core/api/transform/token-buffer-engine.ts",
			"import": "./src/core/api/transform/token-buffer-engine.ts"
		},
		"./db": {
			"types": "./src/infrastructure/db/SQLiteMaintenanceEngine.ts",
			"import": "./src/infrastructure/db/SQLiteMaintenanceEngine.ts"
		},
		"./disk": {
			"types": "./src/core/storage/disk.ts",
			"import": "./src/core/storage/disk.ts"
		},
		"./providers": {
			"types": "./src/core/api/providers/cerebras.ts",
			"import": "./src/core/api/providers/cerebras.ts"
		},
		"./package.json": "./package.json"
	},

	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json"
	},

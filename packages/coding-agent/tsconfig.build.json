{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"outDir": "./dist",
		"paths": {
			"@noorm/lumi-agent-core": ["../agent/dist/index.d.ts"],
			"@noorm/lumi-agent-core/node": ["../agent/dist/node.d.ts"],
			"@noorm/lumi-agent-core/*": ["../agent/dist/*.d.ts"],
			"@oh-my-pi/pi-agent": ["../agent/dist/index.d.ts"],
			"@oh-my-pi/pi-agent-core": ["../agent/dist/index.d.ts"],
			"@oh-my-pi/pi-agent-core/node": ["../agent/dist/node.d.ts"],
			"@oh-my-pi/pi-agent-core/*": ["../agent/dist/*.d.ts"],
			"@oh-my-pi/pi-agent/*": ["../agent/dist/*.d.ts"],
			"@noorm/lumi-ai": ["../ai/dist/index.d.ts"],
			"@noorm/lumi-ai/oauth": ["../ai/dist/oauth.d.ts"],
			"@noorm/lumi-ai/*": ["../ai/dist/*.d.ts", "../ai/dist/providers/*.d.ts"],
			"@oh-my-pi/pi-ai": ["../ai/dist/index.d.ts"],
			"@oh-my-pi/pi-ai/oauth": ["../ai/dist/oauth.d.ts"],
			"@oh-my-pi/pi-ai/*": ["../ai/dist/*.d.ts", "../ai/dist/providers/*.d.ts"],
			"@noorm/lumi-client": ["../client/dist/index.d.ts"],
			"@oh-my-pi/pi-client": ["../client/dist/index.d.ts"],
			"@noorm/lumi-codemarie": ["../codemarie/dist/index.d.ts"],
			"@noorm/lumi-codemarie/*": ["../codemarie/dist/index.d.ts"],
			"@noorm/lumi-protocol": ["../protocol/dist/index.d.ts"],
			"@oh-my-pi/pi-wire": ["../protocol/dist/index.d.ts"],
			"@noorm/lumi-tui": ["../tui/dist/index.d.ts"],
			"@noorm/lumi-tui/*": ["../tui/dist/*.d.ts", "../tui/dist/components/*.d.ts"],
			"@oh-my-pi/pi-tui": ["../tui/dist/index.d.ts"],
			"@oh-my-pi/pi-tui/*": ["../tui/dist/*.d.ts", "../tui/dist/components/*.d.ts"]
		},
		"rootDir": "./src"
	},
	"include": ["src/**/*.ts", "src/**/*.d.ts"],
	"exclude": ["node_modules", "dist"]
}

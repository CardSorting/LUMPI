{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"paths": {
			"*": ["./*"],
			"@noorm/lumpi-telemetry": ["./packages/telemetry/src/index.ts"],
			"@noorm/lumpi-ai": ["./packages/ai/src/index.ts"],
			"@noorm/lumpi-ai/oauth": ["./packages/ai/src/oauth.ts"],
			"@noorm/lumpi-ai/*": ["./packages/ai/src/*.ts", "./packages/ai/src/providers/*.ts"],
			"@noorm/lumpi-ai/dist/*": ["./packages/ai/src/*"],
			"@noorm/lumpi-agent-core": ["./packages/agent/src/index.ts"],
			"@noorm/lumpi-agent-core/node": ["./packages/agent/src/node.ts"],
			"@noorm/lumpi-agent-core/session/testing": [
				"./packages/agent/src/harness/session/testing/index.ts"
			],
			"@noorm/lumpi-agent-core/*": ["./packages/agent/src/*"],
			"@noorm/lumpi-session-backend-sqlite-node": ["./packages/session-backends/sqlite-node/src/index.ts"],
			"@noorm/lumpi": ["./packages/coding-agent/src/index.ts"],
			"@noorm/lumpi/hooks": ["./packages/coding-agent/src/core/hooks/index.ts"],
			"@noorm/lumpi/*": ["./packages/coding-agent/src/*"],
			"@noorm/lumpi-coding-agent": ["./packages/coding-agent/src/index.ts"],
			"@noorm/lumpi-coding-agent/hooks": ["./packages/coding-agent/src/core/hooks/index.ts"],
			"@noorm/lumpi-coding-agent/*": ["./packages/coding-agent/src/*"],
			"@noorm/lumpi-protocol": ["./packages/protocol/src/index.ts"],
			"@noorm/lumpi-protocol/*": ["./packages/protocol/src/*"],
			"@noorm/lumpi-client": ["./packages/client/src/index.ts"],
			"@noorm/lumpi-client/*": ["./packages/client/src/*"],
			"@noorm/lumpi-server": ["./packages/server/src/index.ts"],
			"@noorm/lumpi-server/*": ["./packages/server/src/*"],
			"typebox": ["./node_modules/typebox"],
			"@noorm/lumpi-tui": ["./packages/tui/src/index.ts"],
			"@noorm/lumpi-tui/*": ["./packages/tui/src/*"],
			"@noorm/lumpi-agent-old": ["./packages/agent-old/src/index.ts"],
			"@noorm/lumpi-agent-old/*": ["./packages/agent-old/src/*"],
			"@noorm/lumpi-codemarie": ["./packages/codemarie/dist/index.d.ts"],
			"@noorm/lumpi-codemarie/joyride": ["./packages/codemarie/dist/index.d.ts"],
			"@noorm/lumpi-codemarie/*": ["./packages/codemarie/dist/index.d.ts"],

			"@noorm/broccolidb": ["./packages/broccolidb/src/index.ts"],
			"@noorm/broccolidb/*": ["./packages/broccolidb/src/*"]
		}
	},
	"include": [
		"packages/{agent,ai,client,coding-agent,protocol,server,telemetry,tui}/src/**/*",
		"packages/{agent,ai,client,coding-agent,protocol,server,telemetry,tui}/test/**/*",
		"packages/session-backends/*/src/**/*",
		"packages/session-backends/*/test/**/*",
		"packages/coding-agent/examples/**/*"
	],
	"exclude": ["**/dist/**", "packages/coding-agent/examples/extensions/gondolin/**", "**/packages/codemarie/**"]
}



